# Copy these values to the server-side .env file. Do not commit the resulting file.
PFG_ENV=production
PFG_HOST=127.0.0.1
PFG_PORT=8000
PFG_DATA_DIR=./PFG_CRAVINGS_DATA
PFG_PUBLIC_ORIGIN=https://pfgcravings.com
PFG_CORS_ORIGINS=https://pfgcravings.com
PFG_SECURE_COOKIES=1
# Caddy runs locally and is the only trusted proxy.
PFG_FORWARDED_ALLOW_IPS=127.0.0.1
