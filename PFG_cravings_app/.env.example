# Copy to .env and adjust. Do not commit secrets. These values are safe for local development.
PFG_ENV=development
PFG_HOST=0.0.0.0
PFG_PORT=8000
PFG_DATA_DIR=./PFG_CRAVINGS_DATA
# Set 1 only when accessed through HTTPS and a configured TLS reverse proxy.
PFG_SECURE_COOKIES=0
# Leave blank for localhost development. Production settings are in deploy/.env.production.example.
PFG_PUBLIC_ORIGIN=
PFG_CORS_ORIGINS=
# Trust proxy headers only from the local reverse proxy by default.
PFG_FORWARDED_ALLOW_IPS=127.0.0.1
# Optional local-network alias.  Set to 1 only when mDNS is required.
PFG_MDNS_ENABLED=0
PFG_MDNS_HOSTNAME=pfgcravings.local
# Leave blank to advertise the active LAN address automatically.
PFG_MDNS_ADDRESS=
